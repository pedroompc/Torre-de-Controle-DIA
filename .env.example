# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_NAME=torre-controle
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8001

# ─── Oracle (Winthor) ─────────────────────────────────────────────────────────
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_QUERY_TIMEOUT_SECONDS=60

# ─── Fusion (Roteirizador) ────────────────────────────────────────────────────
# Quando disponível: preencher URL base e credenciais da API ou banco
FUSION_ENABLED=false
FUSION_API_URL=
FUSION_API_TOKEN=
# Alternativa via banco de dados direto:
# FUSION_DB_HOST=
# FUSION_DB_PORT=
# FUSION_DB_NAME=
# FUSION_DB_USER=
# FUSION_DB_PASSWORD=

# ─── Claude / IA ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modelo rápido para produção; trocar por claude-sonnet-4-6 para maior precisão
AI_MODEL=claude-haiku-4-5-20251001
AI_ENABLED=true

# ─── WhatsApp / Evolution API ────────────────────────────────────────────────
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=http://evolution-api:8080/message/sendText/torre-controle
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TIMEOUT_SECONDS=30

# ─── Evolution API ───────────────────────────────────────────────────────────
# Chave de autenticação da Evolution API (crie qualquer string segura)
EVOLUTION_API_KEY=

# ─── Alertas ─────────────────────────────────────────────────────────────────
# Horas sem faturar após liberação para gerar alerta
ALERTA_HORAS_SEM_FATURA=72
# Horas com nota emitida mas sem saída de carga para gerar alerta
ALERTA_HORAS_FATURADO_SEM_CARGA=24

# ─── Log ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
